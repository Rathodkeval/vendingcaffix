{
  "version": 2,
  "outputDirectory": "caffix-app/dist",
  "crons": [
    {
      "path": "/api/cron/auto-refund?limit=20",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
